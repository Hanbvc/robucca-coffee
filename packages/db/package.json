{
  "name": "@robucca/db",
  "version": "0.0.0",
  "private": true,
  "description": "Skema PostgreSQL (Prisma) — satu sumber data untuk 4 cabang, POS, PWA, dan dasbor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/seed/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@robucca/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
