{
  "name": "@robucca/pwa",
  "version": "0.0.0",
  "private": true,
  "description": "Aplikasi pelanggan (Next.js App Router, ekspor statis): menu, Pick Up / Delivery, status pesanan, reservasi meja, akun WhatsApp, menu baca-saja.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "dev": "node scripts/sync-assets.mjs && next dev --port 3001",
    "build": "node scripts/sync-assets.mjs && next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@robucca/core": "workspace:*",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@robucca/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
